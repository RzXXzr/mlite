{{define "content"}}
<style>
#tbl_response th, #tbl_response td { white-space: nowrap; }
</style>
<div class="panel panel-default">
    <div class="panel-heading">
        <div class="btn-group pull-right" style="margin-top:-8px;">
            <span class="btn btn-sm dropdown-toggle" data-toggle="dropdown">
                <i class="fa fa-calendar"></i><span class="hidden-xs"> Periode Tanggal</span>
            </span>
            <ul class="dropdown-menu dropdown-menu-right" style="padding:10px;min-width:220px;">
                <li style="padding:0 5px;">
                    <label style="font-size:12px;margin-bottom:2px;">Tanggal Awal</label>
                    <input type="text" id="tanggal_awal" class="form-control tanggal" required>
                </li>
                <li style="padding:0 5px;margin-top:5px;">
                    <label style="font-size:12px;margin-bottom:2px;">Tanggal Akhir</label>
                    <input type="text" id="tanggal_akhir" class="form-control tanggal" required>
                </li>
                <li style="padding:0 5px;margin-top:5px;">
                    <button class="btn btn-primary btn-block" id="btnFilterDate">Cari</button>
                </li>
            </ul>
        </div>
        <h3 class="panel-title">Data Response Satu Sehat
            <a href="/api/forward-tanggal" class="btn btn-info btn-xs" target="_blank"><i class="fa fa-send"></i> Kirim Massal</a>
        </h3>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-12" id="tbl_response">
                <table class="table display table-bordered table-striped" width="100%" id="responseTable">
                    <thead>
                        <tr>
                            <th>Tgl. Rawat</th>
                            <th>No. Rawat</th>
                            <th>No. RM</th>
                            <th>Nama Pasien</th>
                            <th>No. KTP Pasien</th>
                            <th>Kd. Dokter (ID Praktisi)</th>
                            <th>Nama Dokter</th>
                            <th>No. KTP Dokter</th>
                            <th>Kd. Poli/Unit</th>
                            <th>Poli/Unit</th>
                            <th>Status Rawat</th>
                            <th>Status Lanjut</th>
                            <th>Status Bayar</th>
                            <th>Tgl. Pulang</th>
                            <th>ID Departemen</th>
                            <th>ID Lokasi</th>
                            <th>ID Encounter</th>
                            <th>ID Condition</th>
                            <th>ID Clinical Impression</th>
                            <th>ID Obs. Tensi</th>
                            <th>ID Obs. Nadi</th>
                            <th>ID Obs. RR</th>
                            <th>ID Obs. Suhu</th>
                            <th>ID Obs. SPO2</th>
                            <th>ID Obs. GCS</th>
                            <th>ID Obs. Tinggi</th>
                            <th>ID Obs. Berat</th>
                            <th>ID Obs. Perut</th>
                            <th>ID Obs. Kesadaran</th>
                            <th>ID Procedure</th>
                            <th>ID Composition</th>
                            <th>ID Med. Request</th>
                            <th>ID Med. Dispense</th>
                            <th>ID Med. Statement</th>
                            <th>ID Rad. Request</th>
                            <th>ID Rad. Specimen</th>
                            <th>ID Rad. Observation</th>
                            <th>ID Rad. Diagnostic</th>
                            <th>Image Study</th>
                            <th>ID Lab PK Request</th>
                            <th>ID Lab PK Specimen</th>
                            <th>ID Lab PK Observation</th>
                            <th>ID Lab PK Diagnostic</th>
                            <th>ID Care Plan</th>
                            <th>ID Allergy</th>
                            <th>ID Questionnaire</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- Modal for actions -->
<div class="modal fade" id="actionModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="modalContent">
            <div class="modal-body text-center"><i class="fa fa-spinner fa-spin fa-2x"></i> Loading...</div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts"}}
<script>
$(document).ready(function(){
    var tanggal_awal = '', tanggal_akhir = '';

    function loadTable() {
        if ($.fn.DataTable.isDataTable('#responseTable')) {
            $('#responseTable').DataTable().destroy();
        }
        var url = '/api/response?tanggal_awal=' + encodeURIComponent(tanggal_awal) + '&tanggal_akhir=' + encodeURIComponent(tanggal_akhir);

        window.responseTable = $('#responseTable').DataTable({
            processing: true,
            serverSide: true,
            scrollX: true,
            scrollCollapse: true,
            fixedColumns: { left: 4 },
            ajax: {
                url: url,
                type: 'GET',
                dataSrc: function(json) { return json.data || []; },
                error: function(xhr, error, thrown) {
                    console.error('DataTables error:', error, thrown, xhr.responseText);
                }
            },
            language: { search: "", searchPlaceholder: "Search..." },
            columns: [
                { data: 'tgl_registrasi' },
                { data: 'no_rawat' },
                { data: 'no_rkm_medis', render: function(data, type, row) {
                    var noRawat = (row.no_rawat||'').replace(/\//g, '--');
                    var hasDx = row.diagnosa_pasien && row.diagnosa_pasien.kd_penyakit;
                    if(!row.id_encounter && hasDx && row.tgl_pulang) {
                        return data + ' <br><a href="#" class="btn btn-xs btn-info btn-action" data-id="'+noRawat+'" data-tipe="encounterbundle"><i class="fa fa-plus"></i></a>' +
                            ' <a href="#" class="btn btn-xs btn-danger btn-action" data-id="'+noRawat+'" data-tipe="forwardnorawat"><i class="fa fa-send"></i></a>';
                    } else if(!row.id_encounter && !row.tgl_pulang && !hasDx) {
                        return data + ' <br><span class="badge badge-error">Belum Closing & Belum Input Diagnosa</span>';
                    } else if(!row.id_encounter && !row.tgl_pulang) {
                        return data + ' <br><span class="badge badge-error">Belum Closing</span>';
                    } else if(!row.id_encounter && row.tgl_pulang && !hasDx) {
                        return data + ' <br><span class="badge badge-error">Belum Input Diagnosa</span>';
                    } else if(row.id_encounter && row.id_condition) {
                        return data + ' <br><span class="badge badge-success">Sudah di Kirim</span>';
                    } else if(row.id_encounter && !row.id_condition) {
                        return data + ' <br><span class="badge badge-warning">Sudah di Kirim Sebagian</span>';
                    }
                    return data;
                }},
                { data: 'nm_pasien' },
                { data: 'no_ktp_pasien' },
                { data: 'kd_dokter', render: function(d,t,row){ return d + ' (' + (row.praktisi_id||'') + ')'; }},
                { data: 'nm_dokter' },
                { data: 'no_ktp_dokter' },
                { data: 'kd_poli' },
                { data: 'nm_poli' },
                { data: 'stts' },
                { data: 'status_lanjut' },
                { data: 'status_bayar' },
                { data: 'tgl_pulang' },
                { data: 'id_organisasi' },
                { data: 'id_lokasi' },
                { data: 'id_encounter', render: renderFhirCol('encounter', 'id_encounter', 'tgl_pulang') },
                { data: 'id_condition', render: renderFhirColDx('condition') },
                { data: 'id_clinical_impression', render: renderFhirColField('clinicalimpression', 'id_clinical_impression', 'clinical_impression') },
                { data: 'id_observation_ttvtensi', render: renderObsCol('tensi', 'id_observation_ttvtensi', 'pemeriksaan', 'tensi') },
                { data: 'id_observation_ttvnadi', render: renderObsCol('nadi', 'id_observation_ttvnadi', 'pemeriksaan', 'nadi') },
                { data: 'id_observation_ttvrespirasi', render: renderObsCol('respirasi', 'id_observation_ttvrespirasi', 'pemeriksaan', 'respirasi') },
                { data: 'id_observation_ttvsuhu', render: renderObsCol('suhu', 'id_observation_ttvsuhu', 'pemeriksaan', 'suhu_tubuh') },
                { data: 'id_observation_ttvspo2', render: renderObsCol('spo2', 'id_observation_ttvspo2', 'pemeriksaan', 'spo2') },
                { data: 'id_observation_ttvgcs', render: renderObsCol('gcs', 'id_observation_ttvgcs', 'pemeriksaan', 'gcs') },
                { data: 'id_observation_ttvtinggi', render: renderObsCol('tinggi', 'id_observation_ttvtinggi', 'pemeriksaan', 'tinggi') },
                { data: 'id_observation_ttvberat', render: renderObsCol('berat', 'id_observation_ttvberat', 'pemeriksaan', 'berat') },
                { data: 'id_observation_ttvperut', render: renderObsCol('perut', 'id_observation_ttvperut', 'pemeriksaan', 'lingkar_perut') },
                { data: 'id_observation_ttvkesadaran', render: renderObsCol('kesadaran', 'id_observation_ttvkesadaran', 'pemeriksaan', 'kesadaran') },
                { data: 'id_procedure', render: renderFhirColField('procedure', 'id_procedure', 'prosedur_pasien') },
                { data: 'id_composition', render: renderFhirColField('dietgizi', 'id_composition', 'adime_gizi') },
                { data: 'id_medication_request', render: renderFhirColMed('request', 'id_medication_request', 'medication_request') },
                { data: 'id_medication_dispense', render: renderFhirColMed('dispense', 'id_medication_dispense', 'medication_dispense') },
                { data: 'id_medication_statement', render: renderFhirColMed('statement', 'id_medication_statement', 'medication_statement') },
                { data: 'id_rad_request', render: renderFhirColRad('request', 'id_rad_request', 'service_request_radiologi') },
                { data: 'id_rad_specimen', render: renderFhirColRad('specimen', 'id_rad_specimen', 'specimen_radiologi') },
                { data: 'id_rad_observation', render: renderFhirColRad('observation', 'id_rad_observation', 'observation_radiologi') },
                { data: 'id_rad_diagnostic', render: renderFhirColRad('diagnostic', 'id_rad_diagnostic', 'diagnostic_report_radiologi') },
                { data: 'id_rad_request', render: function(d,t,row) {
                    if(!row.id_rad_request) return '<span class="badge badge-error">Belum Ada</span>';
                    return '<a href="#" class="badge badge-success btn-action" data-id="'+noRawatConv(row)+'" data-tipe="radiology" data-ttv="image">Post Image Study</a>';
                }},
                { data: 'id_lab_pk_request', render: renderFhirColLab('request', 'id_lab_pk_request', 'service_request_lab_pk') },
                { data: 'id_lab_pk_specimen', render: renderFhirColLab('specimen', 'id_lab_pk_specimen', 'specimen_lab_pk') },
                { data: 'id_lab_pk_observation', render: renderFhirColLab('observation', 'id_lab_pk_observation', 'observation_lab_pk') },
                { data: 'id_lab_pk_diagnostic', render: renderFhirColLab('diagnostic', 'id_lab_pk_diagnostic', 'diagnostic_report_lab_pk') },
                { data: 'id_careplan', render: renderFhirColField('careplan', 'id_careplan', 'care_plan') },
                { data: 'id_allergy', render: renderFhirColField('allergy', 'id_allergy', 'allergy') },
                { data: 'id_questionnaire', render: renderFhirColField('questionnaire', 'id_questionnaire', 'questionnaire') }
            ],
            lengthChange: false,
            dom: "<<'data-table-title'><'datatable-search'f>><'row'<'col-sm-12'tr>><<'pmd-datatable-pagination' l i p>>"
        });
    }

    function noRawatConv(row) { return (row.no_rawat||'').replace(/\//g, '--'); }

    function renderFhirCol(tipe, idField, reqField) {
        return function(d,t,row) {
            var noRawat = noRawatConv(row);
            if(!row[idField] && row[reqField]) return '<a href="#" class="btn btn-xs btn-info btn-action" data-id="'+noRawat+'" data-tipe="'+tipe+'"><i class="fa fa-check"></i></a>';
            if(!row[idField]) return '<span class="badge badge-error">Belum Closing</span>';
            return d;
        };
    }
    function renderFhirColDx(tipe) {
        return function(d,t,row) {
            var noRawat = noRawatConv(row);
            var hasDx = row.diagnosa_pasien && row.diagnosa_pasien.kd_penyakit;
            if(!row.id_condition && hasDx) return '<a href="#" class="btn btn-xs btn-info btn-action" data-id="'+noRawat+'" data-tipe="'+tipe+'"><i class="fa fa-check"></i></a>';
            if(!row.id_condition) return '<span class="badge badge-error">Diagnosa Kosong</span>';
            return d;
        };
    }
    function renderFhirColField(tipe, idField, dataField) {
        return function(d,t,row) {
            var noRawat = noRawatConv(row);
            if(!row[idField] && row[dataField]) return '<a href="#" class="btn btn-xs btn-info btn-action" data-id="'+noRawat+'" data-tipe="'+tipe+'"><i class="fa fa-check"></i></a>';
            if(!row[idField]) return '<span class="badge badge-error">Kosong</span>';
            return d;
        };
    }
    function renderObsCol(ttv, idField, parent, key) {
        return function(d,t,row) {
            var noRawat = noRawatConv(row);
            var val = row[parent] ? String(row[parent][key]||'').trim() : '';
            if(!row[idField] && val && val !== '-') return '<a href="#" class="btn btn-xs btn-info btn-action" data-id="'+noRawat+'" data-tipe="observation" data-ttv="'+ttv+'"><i class="fa fa-check"></i></a>';
            if(!row[idField]) return '<span class="badge badge-error">Kosong</span>';
            return d;
        };
    }
    function renderFhirColMed(ttv, idField, dataField) {
        return function(d,t,row) {
            var noRawat = noRawatConv(row);
            if(!row[idField] && row[dataField]) return '<a href="#" class="btn btn-xs btn-info btn-action" data-id="'+noRawat+'" data-tipe="medication" data-ttv="'+ttv+'"><i class="fa fa-check"></i></a>';
            if(!row[idField]) return '<span class="badge badge-error">Kosong</span>';
            return d;
        };
    }
    function renderFhirColRad(ttv, idField, dataField) {
        return function(d,t,row) {
            var noRawat = noRawatConv(row);
            var val = row[dataField]||'';
            if(!row[idField] && val && val !== '0000-00-00') return '<a href="#" class="btn btn-xs btn-info btn-action" data-id="'+noRawat+'" data-tipe="radiology" data-ttv="'+ttv+'"><i class="fa fa-check"></i></a>';
            if(!row[idField]) return '<span class="badge badge-error">Kosong</span>';
            return d;
        };
    }
    function renderFhirColLab(ttv, idField, dataField) {
        return function(d,t,row) {
            var noRawat = noRawatConv(row);
            var val = row[dataField]||'';
            if(!row[idField] && val && val !== '0000-00-00') return '<a href="#" class="btn btn-xs btn-info btn-action" data-id="'+noRawat+'" data-tipe="laboratory" data-ttv="'+ttv+'"><i class="fa fa-check"></i></a>';
            if(!row[idField]) return '<span class="badge badge-error">Kosong</span>';
            return d;
        };
    }

    loadTable();

    // Date filter
    $('#btnFilterDate').on('click', function(e){
        e.preventDefault();
        tanggal_awal = $('#tanggal_awal').val();
        tanggal_akhir = $('#tanggal_akhir').val();
        loadTable();
    });

    // Action modal
    $(document).on('click', '.btn-action', function(e){
        e.preventDefault();
        var id = $(this).data('id');
        var tipe = $(this).data('tipe');
        var ttv = $(this).data('ttv') || '';

        if(tipe === 'forwardnorawat') {
            processForwardNoRawat(id);
            return;
        }

        var url;
        // Map tipe to actual API route (some have hyphens)
        var routeMap = {
            'clinicalimpression': 'clinical-impression',
            'careplan': 'care-plan',
            'dietgizi': 'composition'
        };
        var apiTipe = routeMap[tipe] || tipe;
        if(tipe === 'encounterbundle') {
            url = '/api/encounter/' + id + '?bundle=1';
        } else if(ttv) {
            url = '/api/' + apiTipe + '/' + id + '/' + ttv;
        } else {
            url = '/api/' + apiTipe + '/' + id;
        }
        $('#modalContent').html('<div class="modal-body text-center"><i class="fa fa-spinner fa-spin fa-2x"></i> Mengirim data...</div>');
        $('#actionModal').modal('show');
        $.get(url, function(resp) {
            var pretty = typeof resp === 'string' ? resp : JSON.stringify(resp, null, 2);
            $('#modalContent').html(
                '<div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title">Response Satu Sehat</h4></div>' +
                '<div class="modal-body"><pre style="max-height:400px;overflow:auto;">'+$('<div>').text(pretty).html()+'</pre></div>' +
                '<div class="modal-footer"><button type="button" class="btn btn-primary" data-dismiss="modal">Tutup</button></div>'
            );
        }).fail(function(xhr){
            $('#modalContent').html(
                '<div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title text-danger">Error</h4></div>' +
                '<div class="modal-body"><pre>'+xhr.responseText+'</pre></div>' +
                '<div class="modal-footer"><button type="button" class="btn btn-primary" data-dismiss="modal">Tutup</button></div>'
            );
        });
    });

    function processForwardNoRawat(id) {
        var noRawatDisplay = id.replace(/--/g, '/');
        var steps = [
            {name: 'Encounter', url: '/api/encounter/' + id},
            {name: 'Condition', url: '/api/condition/' + id},
            {name: 'Obs. Tensi', url: '/api/observation/' + id + '/tensi'},
            {name: 'Obs. Nadi', url: '/api/observation/' + id + '/nadi'},
            {name: 'Obs. Respirasi', url: '/api/observation/' + id + '/respirasi'},
            {name: 'Obs. Suhu', url: '/api/observation/' + id + '/suhu'},
            {name: 'Obs. SpO2', url: '/api/observation/' + id + '/spo2'},
            {name: 'Obs. GCS', url: '/api/observation/' + id + '/gcs'},
            {name: 'Obs. Kesadaran', url: '/api/observation/' + id + '/kesadaran'},
            {name: 'Obs. Berat', url: '/api/observation/' + id + '/berat'},
            {name: 'Obs. Tinggi', url: '/api/observation/' + id + '/tinggi'},
            {name: 'Obs. Perut', url: '/api/observation/' + id + '/perut'},
            {name: 'Procedure', url: '/api/procedure/' + id},
            {name: 'Clinical Impression', url: '/api/clinical-impression/' + id},
            {name: 'Care Plan', url: '/api/care-plan/' + id},
            {name: 'Allergy', url: '/api/allergy/' + id},
            {name: 'Med. Request', url: '/api/medication/' + id + '/request'},
            {name: 'Med. Dispense', url: '/api/medication/' + id + '/dispense'},
            {name: 'Med. Statement', url: '/api/medication/' + id + '/statement'},
            {name: 'Lab. Request', url: '/api/laboratory/' + id + '/request'},
            {name: 'Lab. Specimen', url: '/api/laboratory/' + id + '/specimen'},
            {name: 'Lab. Observation', url: '/api/laboratory/' + id + '/observation'},
            {name: 'Lab. Diagnostic', url: '/api/laboratory/' + id + '/diagnostic'},
            {name: 'Rad. Request', url: '/api/radiology/' + id + '/request'},
            {name: 'Rad. Specimen', url: '/api/radiology/' + id + '/specimen'},
            {name: 'Rad. Observation', url: '/api/radiology/' + id + '/observation'},
            {name: 'Rad. Diagnostic', url: '/api/radiology/' + id + '/diagnostic'}
        ];

        // Group steps: Encounter must go first, then remaining parallel with rate limiter
        // Med. Request → Dispense → Statement must be sequential within their group
        var encounterStep = steps[0];
        var parallelSteps = steps.slice(1, 16); // Condition through Allergy (indices 1-15)
        var medSteps = steps.slice(16, 19);      // Med. Request, Dispense, Statement (sequential)
        var labSteps = steps.slice(19, 23);      // Lab (sequential within group)
        var radSteps = steps.slice(23, 27);      // Rad (sequential within group)

        var html = '<div class="modal-header">' +
            '<button type="button" class="close" data-dismiss="modal">&times;</button>' +
            '<h4 class="modal-title"><i class="fa fa-send"></i> Proses no_rawat ' + noRawatDisplay + '</h4></div>' +
            '<div class="modal-body" style="max-height:500px;overflow-y:auto;padding:10px 15px;">' +
            '<div class="alert alert-info" style="padding:8px;margin-bottom:10px;font-size:12px;">' +
            '<i class="fa fa-info-circle"></i> Mengirim ' + steps.length + ' resource FHIR ke Satu Sehat (paralel, max 3 concurrent)...</div>' +
            '<table class="table table-condensed" style="font-size:12px;margin:0;">' +
            '<thead><tr><th style="width:30px">#</th><th>Resource</th><th style="width:120px;">Status</th><th style="width:200px;">ID Satu Sehat</th></tr></thead><tbody>';
        for(var i=0; i<steps.length; i++) {
            html += '<tr id="step-'+i+'"><td>'+(i+1)+'</td><td>'+steps[i].name+'</td>' +
                '<td class="step-status"><span class="text-muted"><i class="fa fa-clock-o"></i> Menunggu</span></td>' +
                '<td class="step-id text-muted">-</td></tr>';
        }
        html += '</tbody></table></div>' +
            '<div class="modal-footer">' +
            '<span id="processProgress" class="pull-left" style="line-height:34px;font-size:12px;">0 / '+steps.length+'</span>' +
            '<button type="button" class="btn btn-default" data-dismiss="modal">Tutup</button></div>';

        $('#modalContent').html(html);
        $('#actionModal').modal({backdrop:'static', keyboard:false});

        var completed = 0;
        var successCount = 0;
        var errorCount = 0;
        var total = steps.length;

        function updateProgress() {
            completed++;
            $('#processProgress').text(completed + ' / ' + total);
            if(completed >= total) {
                $('#processProgress').html('<span class="text-success"><i class="fa fa-check"></i> Selesai — '+successCount+' sukses, '+errorCount+' gagal</span>');
            }
        }

        // Process single step, returns a Promise
        function sendStep(stepIdx) {
            var step = steps[stepIdx];
            var $row = $('#step-'+stepIdx);
            $row.find('.step-status').html('<span class="text-primary"><i class="fa fa-spinner fa-spin"></i> Mengirim...</span>');
            var $body = $row.closest('.modal-body');
            $body.scrollTop($body.scrollTop() + $row.position().top - $body.height()/2);

            return $.ajax({
                url: step.url,
                method: 'GET',
                dataType: 'json',
                timeout: 60000
            }).then(function(data) {
                var hasError = false;
                var resID = '-';
                if(data && data.issue) hasError = true;
                if(data && data.error && !data.response && !data.responses) hasError = true;
                if(data && data.pesan && data.pesan.indexOf('Gagal') !== -1) hasError = true;
                if(data && data.response && data.response.resourceType === 'OperationOutcome') hasError = true;
                if(data && data.id) resID = data.id;
                else if(data && data.response && data.response.id) resID = data.response.id;
                else if(data && data.pesan && data.pesan.indexOf('Sukses') !== -1) hasError = false;

                if(hasError) {
                    var errMsg = 'Error';
                    if(data.error) errMsg = data.error;
                    else if(data.issue && data.issue[0]) errMsg = data.issue[0].diagnostics || data.issue[0].details.text || 'Error';
                    $row.find('.step-status').html('<span class="text-danger" title="'+$('<span>').text(errMsg).html()+'"><i class="fa fa-exclamation-triangle"></i> Gagal</span>');
                    $row.find('.step-id').html('<small class="text-danger">'+$('<span>').text(errMsg).html().substring(0,40)+'</small>');
                    errorCount++;
                } else {
                    $row.find('.step-status').html('<span class="text-success"><i class="fa fa-check"></i> Sukses</span>');
                    $row.find('.step-id').html('<code style="font-size:10px;">'+$('<span>').text(resID).html()+'</code>');
                    successCount++;
                }
                updateProgress();
                return {ok: !hasError, idx: stepIdx};
            }, function(xhr) {
                var errMsg = 'HTTP ' + xhr.status;
                try { var r = JSON.parse(xhr.responseText); if(r.error) errMsg = r.error; } catch(e){}
                $row.find('.step-status').html('<span class="text-warning" title="'+$('<span>').text(errMsg).html()+'"><i class="fa fa-minus-circle"></i> Skip</span>');
                $row.find('.step-id').html('<small class="text-muted">'+$('<span>').text(errMsg).html().substring(0,40)+'</small>');
                errorCount++;
                updateProgress();
                return $.Deferred().resolve({ok: false, idx: stepIdx}).promise();
            });
        }

        // Run array of step indices sequentially (chain)
        function runSequential(indices) {
            var d = $.Deferred().resolve();
            $.each(indices, function(_, stepIdx) {
                d = d.then(function() { return sendStep(stepIdx); });
            });
            return d;
        }

        // Rate-limited parallel runner: max N concurrent from a list of tasks (each task is a function returning a promise)
        function runParallelLimited(tasks, maxConcurrent) {
            var d = $.Deferred();
            var running = 0;
            var queue = tasks.slice();
            var results = [];
            function next() {
                while(running < maxConcurrent && queue.length > 0) {
                    (function() {
                        var task = queue.shift();
                        running++;
                        task().always(function(res) {
                            results.push(res);
                            running--;
                            if(queue.length === 0 && running === 0) {
                                d.resolve(results);
                            } else {
                                next();
                            }
                        });
                    })();
                }
            }
            if(tasks.length === 0) { d.resolve([]); } else { next(); }
            return d.promise();
        }

        // === MAIN FLOW ===
        // Step 1: Send Encounter first (required by all others)
        sendStep(0).then(function(res) {
            if(!res.ok) {
                // Encounter failed — still try the rest but they'll likely fail
            }

            // Step 2: Build task list — parallel group + sequential chains
            var tasks = [];

            // Parallel independent steps (Condition, Observations, Procedure, Clinical Impression, Care Plan, Allergy)
            parallelSteps.forEach(function(_, i) {
                var stepIdx = i + 1; // offset by encounter (index 0)
                tasks.push(function() { return sendStep(stepIdx); });
            });

            // Medication chain (Request → Dispense → Statement) as one task
            tasks.push(function() {
                return runSequential([16, 17, 18]);
            });

            // Lab chain (Request → Specimen → Observation → Diagnostic) as one task
            tasks.push(function() {
                return runSequential([19, 20, 21, 22]);
            });

            // Radiology chain (Request → Specimen → Observation → Diagnostic) as one task
            tasks.push(function() {
                return runSequential([23, 24, 25, 26]);
            });

            // Run all tasks with rate limiter (max 3 concurrent)
            return runParallelLimited(tasks, 3);
        });
    }

    $('#actionModal').on('hidden.bs.modal', function(){
        if(window.responseTable) window.responseTable.ajax.reload(null, false);
    });

    // Init datepickers
    $('.tanggal').datetimepicker({ format: 'YYYY-MM-DD', locale: 'id' });
});
</script>
{{end}}
